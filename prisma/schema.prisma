// 1. Prisma 클라이언트 및 DB 연결 설정
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// ENUM (상태값 정의 - 오타 방지 및 타입 안정성)
// ------------------------------------------------------
enum Position {
  FOREHAND
  BACKHAND
  ANY
}

enum MatchStatus {
  OPEN       // 모집중
  FULL       // 모집마감
  COMPLETED  // 경기완료
  CANCELED   // 취소됨
}

enum ParticipantStatus {
  PENDING    // 대기중
  ACCEPTED   // 수락됨
  REJECTED   // 거절됨
}

enum Team {
  A
  B
}

enum WinLoss {
  WIN
  LOSS
  DRAW
}

// ------------------------------------------------------
// MODELS (테이블 구조)
// ------------------------------------------------------

// [1] 회원 정보 (users)
model User {
  id             String    @id @default(uuid()) @db.Uuid
  ciDi           String    @unique @map("ci_di") // 본인인증 고유 해시값
  email          String    @unique
  nickname       String
  tennisLevel    String    @map("tennis_level")
  preferredPos   Position  @default(ANY) @map("preferred_pos")
  mannerScore    Decimal   @default(36.5) @map("manner_score") @db.Decimal(4, 1)
  isBanned       Boolean   @default(false) @map("is_banned")
  
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at") // 소프트 딜리트용

  // [Relations - 관계 설정]
  hostedMatches       Match[]             @relation("MatchHost")
  participations      MatchParticipant[]
  evaluationsGiven    Evaluation[]        @relation("Evaluator")
  evaluationsReceived Evaluation[]        @relation("Evaluatee")

  @@map("users") // 실제 DB 생성되는 테이블명
}

// [2] 테니스장 정보 (courts)
model Court {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  address   String
  latitude  Decimal  @db.Decimal(10, 7) // 지도 마커용 위도
  longitude Decimal  @db.Decimal(10, 7) // 지도 마커용 경도
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // [Relations]
  matches   Match[]

  @@map("courts")
}

// [3] 매칭 방 (matches)
model Match {
  id          String      @id @default(uuid()) @db.Uuid
  hostId      String      @map("host_id") @db.Uuid
  courtId     String      @map("court_id") @db.Uuid
  matchDate   DateTime    @map("match_date") @db.Date
  startTime   DateTime    @map("start_time") @db.Time
  targetLevel String      @map("target_level")
  status      MatchStatus @default(OPEN)
  
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  // [Relations]
  host         User               @relation("MatchHost", fields: [hostId], references: [id])
  court        Court              @relation(fields: [courtId], references: [id])
  participants MatchParticipant[]
  evaluations  Evaluation[]

  @@map("matches")
}

// [4] 참여자 및 히스토리 (match_participants)
model MatchParticipant {
  id        String            @id @default(uuid()) @db.Uuid
  matchId   String            @map("match_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  team      Team?             // 복식일 경우 A/B팀 배정
  status    ParticipantStatus @default(PENDING)
  
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  // [Relations]
  match     Match @relation(fields: [matchId], references: [id])
  user      User  @relation(fields: [userId], references: [id])

  // 유저가 한 매칭에 중복으로 참여신청을 넣지 못하도록 설정
  @@unique([matchId, userId]) 
  @@map("match_participants")
}

// [5] 블라인드 평가 (evaluations)
model Evaluation {
  id          String   @id @default(uuid()) @db.Uuid
  matchId     String   @map("match_id") @db.Uuid
  evaluatorId String   @map("evaluator_id") @db.Uuid // 평가 한 사람
  evaluateeId String   @map("evaluatee_id") @db.Uuid // 평가 받는 사람
  mannerRating Int      @map("manner_rating") // 예: 1~5점
  skillRating  Int      @map("skill_rating")  // 예: -1(구력뻥튀기), 0(적당함), 1(더잘함)
  winLoss     WinLoss? @map("win_loss")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // [Relations]
  match       Match @relation(fields: [matchId], references: [id])
  evaluator   User  @relation("Evaluator", fields: [evaluatorId], references: [id])
  evaluatee   User  @relation("Evaluatee", fields: [evaluateeId], references: [id])

  // 한 사람이 같은 매칭에서 동일인을 두 번 평가할 수 없도록 설정
  @@unique([matchId, evaluatorId, evaluateeId])
  @@map("evaluations")
}