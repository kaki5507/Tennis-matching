# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Database (Prisma)
DATABASE_URL=
DIRECT_URL=

# PortOne (본인인증)
# https://admin.portone.io 에서 상점(Store) 생성 후 발급받는 값들입니다.
# - NEXT_PUBLIC_PORTONE_STORE_ID / NEXT_PUBLIC_PORTONE_CHANNEL_KEY : 프론트엔드 위젯 호출용 (공개되어도 무방)
# - PORTONE_API_SECRET : 서버에서 인증 결과를 재검증할 때 쓰는 비밀키. 절대 노출 금지.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# Firebase (웹 푸시 알림)
# https://console.firebase.google.com 에서 프로젝트 생성 후 발급받는 값들입니다.
#
# [클라이언트용 - 브라우저에 노출되어도 안전한 공개 설정값]
# 프로젝트 설정 > 일반 > 내 앱(웹 앱 추가) 에서 확인
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 프로젝트 설정 > 클라우드 메시징 > 웹 구성 > 웹 푸시 인증서(VAPID 키)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# [서버 전용 - 절대 노출/커밋 금지]
# 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 (JSON 다운로드 후 아래 3개 값 추출)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 카카오맵 (테니스장 검색/지도 표시)
# https://developers.kakao.com 앱 생성 후 "JavaScript 키" 발급
# 플랫폼 설정 > Web 플랫폼에 실제 도메인(localhost:3000 포함)을 등록해야 동작합니다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# [NEW] 관리자 가입용 초대코드 (아무 랜덤 문자열). 회원가입 시 이 값을
# 정확히 입력한 사람만 관리자(ADMIN) 권한으로 가입됩니다. 절대 공개 저장소나
# 공개된 곳에 실제 값을 적지 마세요. 필요한 사람에게만 직접 알려주세요.
ADMIN_SIGNUP_CODE=

# [NEW] Vercel Cron이 우리 크론 API를 호출할 때 쓰는 인증값 (아무 랜덤 문자열).
# Vercel 배포 시 Vercel 프로젝트 환경변수에도 동일한 값을 등록해야 합니다.
CRON_SECRET=
