# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Database (Prisma)
DATABASE_URL=
DIRECT_URL=

# PortOne (본인인증)
# https://admin.portone.io 에서 상점(Store) 생성 후 발급받는 값들입니다.
# - NEXT_PUBLIC_PORTONE_STORE_ID / NEXT_PUBLIC_PORTONE_CHANNEL_KEY : 프론트엔드 위젯 호출용 (공개되어도 무방)
# - PORTONE_API_SECRET : 서버에서 인증 결과를 재검증할 때 쓰는 비밀키. 절대 노출 금지.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# 포트원 PG 계약 전 "본인인증 없이 가입하기 (임시)" 버튼.
#  - 포트원 설정 3종(위의 STORE_ID, CHANNEL_KEY, API_SECRET) 중 하나라도 비어 있으면 기본으로 켜져 있습니다.
#  - 3종을 모두 넣는 순간 자동으로 닫힙니다.
#  - 긴급히 막고 싶으면 false 로 두세요.
#  - 본인인증을 안 거친 계정은 중복/재가입 차단이 이메일 기준으로만 되므로, 계약 후에는 반드시 키를 넣으세요.
ALLOW_UNVERIFIED_SIGNUP=

# [서버 전용·절대 공개 금지] Supabase 관리자 키 (Supabase 대시보드 > Project Settings > API > service_role).
#  - 테스트 단계(포트원 미설정)에서 "이메일 인증 없이 가입/로그인"을 가능하게 하는 데만 씁니다.
#  - 이름에 NEXT_PUBLIC_ 를 붙이면 브라우저에 노출되니 절대 붙이지 마세요.
#  - 없으면 기능이 꺼지고, Supabase 의 "Confirm email" 설정을 끄는 방법을 써야 합니다.
SUPABASE_SERVICE_ROLE_KEY=

# 테스트 단계 가입에서 이메일 인증을 요구할지 (SUPABASE_SERVICE_ROLE_KEY 가 있을 때만 의미 있음)
#  - true : 가입은 즉시 끝나고(메일 발송을 기다리지 않음) 인증 메일은 백그라운드로 발송, 링크를 눌러야 로그인 가능
#  - 비움 : 인증 없이 가입 즉시 로그인
REQUIRE_EMAIL_CONFIRM=

# Firebase (웹 푸시 알림)
# https://console.firebase.google.com 에서 프로젝트 생성 후 발급받는 값들입니다.
#
# [클라이언트용 - 브라우저에 노출되어도 안전한 공개 설정값]
# 프로젝트 설정 > 일반 > 내 앱(웹 앱 추가) 에서 확인
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 프로젝트 설정 > 클라우드 메시징 > 웹 구성 > 웹 푸시 인증서(VAPID 키)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# [서버 전용 - 절대 노출/커밋 금지]
# 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 (JSON 다운로드 후 아래 3개 값 추출)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 카카오맵 (테니스장 검색/지도 표시)
# https://developers.kakao.com 앱 생성 후 "JavaScript 키" 발급
# 플랫폼 설정 > Web 플랫폼에 실제 도메인(localhost:3000 포함)을 등록해야 동작합니다.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# [NEW] 관리자 가입용 초대코드 (아무 랜덤 문자열). 회원가입 시 이 값을
# 정확히 입력한 사람만 관리자(ADMIN) 권한으로 가입됩니다. 절대 공개 저장소나
# 공개된 곳에 실제 값을 적지 마세요. 필요한 사람에게만 직접 알려주세요.
ADMIN_SIGNUP_CODE=

# [NEW] Vercel Cron이 우리 크론 API를 호출할 때 쓰는 인증값 (아무 랜덤 문자열).
# Vercel 배포 시 Vercel 프로젝트 환경변수에도 동일한 값을 등록해야 합니다.
CRON_SECRET=
